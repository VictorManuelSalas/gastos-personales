# Copia este archivo a .env y cambia los valores.
# Genera secretos con: openssl rand -hex 32

# Base de datos (usa solo letras y números para evitar problemas en la URL)
POSTGRES_PASSWORD=cambia-esto-por-un-secreto-hex

# Firma de sesiones de Better Auth (mínimo 32 caracteres)
BETTER_AUTH_SECRET=cambia-esto-por-otro-secreto-hex

# URL pública de la app. En local: http://localhost:3100
# Con Cloudflare Tunnel: https://quincena.tu-dominio.com
APP_URL=http://localhost:3100

# Puertos en tu máquina (3000 y 5432 ya los usan otros proyectos)
WEB_PORT=3100
DB_PORT=5442

# Token del túnel de Cloudflare (solo si usas el perfil "tunnel")
CLOUDFLARE_TUNNEL_TOKEN=

# Bot de Telegram (crea uno con @BotFather). Sin esto, la app funciona pero sin avisos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Cualquier texto largo (letras, números, _ y -). Telegram lo manda en cada llamada al webhook.
TELEGRAM_WEBHOOK_SECRET=

# IA del servidor (opcional) para leer tickets y notas de voz. Cada usuario puede poner
# su propia llave en Ajustes → Inteligencia artificial; estas se usan si no tiene.
# AI_PROVIDER elige cuál usar por defecto: gemini, openai o anthropic.
AI_PROVIDER=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Cifra las API keys de los usuarios. Si falta se deriva de BETTER_AUTH_SECRET.
# Si la cambias, cada usuario tendrá que capturar su llave otra vez. Genera una con: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Notificaciones push en el teléfono (PWA). Genera las llaves con:
# docker compose -f compose.yaml -f compose.dev.yaml run --rm --no-deps dev sh -c "cd apps/web && npx web-push generate-vapid-keys"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
